{
  "expo": {
    "name": "Hoshino",
    "slug": "hoshino",
    "version": "1.0.0",
    "scheme": "hoshino",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F14"
    },
    "assetBundlePatterns": [
      "assets/**"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerosicx.hoshino"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2658"
      },
      "package": "com.zerosicx.hoshino"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5252a414-2b06-4e25-a716-259ed0dbabc0"
      }
    },
    "owner": "zerosicx",
    "updates": {
      "url": "https://u.expo.dev/5252a414-2b06-4e25-a716-259ed0dbabc0"
    }
  }
}
