{
  "name": "hoshino",
  "version": "1.0.0",
  "author": "Hoshi",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:db": "tsx scripts/build-dictionary.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "test:watch": "vitest",
    "test:components": "jest",
    "test:components:watch": "jest --watch",
    "release:update": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false eas update --branch preview",
    "release:preview": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false eas build --profile preview --platform android",
    "release:production": "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false eas build --profile production --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@supabase/supabase-js": "^2.47.2",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "lucide-react-native": "^1.37.0",
    "@react-navigation/native": "^7.1.8",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "ts-fsrs": "^4.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^11.7.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "fast-xml-parser": "^4.5.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true
}
